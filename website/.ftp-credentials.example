# Spaceship FTP credentials — NEVER commit this file
# Copy this file to .ftp-credentials and fill in your values.

# FTP hostname — use the server name from Spaceship cPanel
# (visible in cPanel → FTP Accounts, or use: server50.shared.spaceship.host)
FTP_HOST=server50.shared.spaceship.host

# Your cPanel username (visible in top-right of cPanel)
FTP_USER=amkqcciqma

# Your cPanel password
FTP_PASS=YOUR_PASSWORD_HERE

# Remote folder where the site lives (almost always /public_html)
REMOTE_DIR=/public_html
